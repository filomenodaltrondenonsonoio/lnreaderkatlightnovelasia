{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@plugins/*": ["./plugins/*"],
      "@libs/*": ["./src/libs/*"]
    },
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["plugins/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules/**", ".js/**", ".dist/**"]
}
