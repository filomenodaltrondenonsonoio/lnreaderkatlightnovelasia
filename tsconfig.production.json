{
  "compilerOptions": {
    "target": "ES5",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@plugins/*": ["./plugins/*"],
      "@libs/*": ["./src/libs/*"]
    },
    "rootDir": "./plugins",
    "outDir": "./.js/plugins",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noCheck": true,
    "noResolve": true,
    "lib": ["ES2020", "DOM"]
  },
  "include": ["plugins/**/*.ts"],
  "exclude": ["plugins/**/*.broken.ts", "plugins/**/*.draft.ts", "node_modules/**", ".js/**", ".dist/**"]
}
